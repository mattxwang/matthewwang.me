{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "bracketSameLine": false
  },
  "linter": {
    "enabled": false
  },
  "html": {
    "formatter": {
      "enabled": true,
      "whitespaceSensitivity": "strict"
    },
		"linter": {
			"enabled": true
		}
  }
}
